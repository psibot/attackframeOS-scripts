# Copy to .env and adjust.  docker compose reads it automatically.

# Where the web console listens (host networking: this is a host address).
# Keep 127.0.0.1 unless you need remote access. Any other address REQUIRES a token.
LANRECCE_BIND=127.0.0.1
LANRECCE_PORT=8088

# Access token for the console. Required when LANRECCE_BIND isn't loopback.
# Generate one:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
LANRECCE_TOKEN=

# Extra Host names the console accepts when no token is set (comma list).
LANRECCE_ALLOWED_HOSTS=

# 1 = let the console scan non-private ranges (authorised engagements only).
LANRECCE_ALLOW_PUBLIC=0

# "Open Dossier" button on the Export tab.
LANRECCE_DOSSIER_URL=http://localhost:8080

# Your uid/gid so ./runs isn't root-owned:  id -u ; id -g
LANRECCE_UID=1000
LANRECCE_GID=1000
TZ=UTC
